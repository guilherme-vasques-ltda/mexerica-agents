{
  "version": 1,
  "rules": [
    { "id": "caminho-pessoal", "marker": true },
    { "id": "ip-privado", "marker": true },
    { "id": "host-interno", "marker": true },
    { "id": "id-servico", "marker": false },
    { "id": "cofre", "marker": false },
    { "id": "arquivo-sensivel", "marker": false }
  ],
  "urlsPermitidas": [
    "github.com/guilherme-vasques-ltda/",
    "git@github.com:guilherme-vasques-ltda/",
    "guilherme-vasques-ltda.github.io"
  ],
  "excecoesTermo": [],
  "genericUsers": ["you", "user", "usuario", "username", "seu-usuario", "shared", "$USER", "${USER}", "<usuario>", "<user>", "<nome>", "<username>", "<seu-usuario>", "runner", "ubuntu", "node", "vscode"],
  "placeholderValues": ["example", "exemplo", "placeholder", "your", "your_id", "your_key", "your_token", "test", "dummy"],
  "limits": ["Somente arquivos com byte NUL são considerados binários; submódulos não são analisados.", "Arquivos .env e arquivos de chaves geram arquivo-sensivel pelo caminho, sem ler o conteúdo.", "Termos pessoais só são verificados quando fornecidos pelo secret; o inventário inicial contém apenas regras públicas."]
}
