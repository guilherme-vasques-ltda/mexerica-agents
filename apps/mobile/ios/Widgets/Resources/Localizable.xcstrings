            "value": "Org chart"
          }
        }
      }
    },
    "Veja quatro bots de relance. Edite o widget para escolher o computador e quem fica em cada posição.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quatro bots de relance. Edite o widget para escolher o computador e quem fica em cada posição."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four bots at a glance. Edit the widget to choose the computer and who sits in each spot."
          }
        }
      }
    },
    "Computador": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
