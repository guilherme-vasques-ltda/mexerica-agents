    "Bots que precisam de você, tarefas em andamento e suas atividades atuais.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bots que precisam de você, tarefas em andamento e suas atividades atuais."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bots that need you, running tasks, and their current activity."
          }
        }
      }
    },
