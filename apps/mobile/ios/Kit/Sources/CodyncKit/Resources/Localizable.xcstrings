    "A visualização remota da tela ainda não está disponível no Windows. Os bots ainda podem usar aplicativos nesse computador.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização remota da tela ainda não está disponível no Windows. Os bots ainda podem usar aplicativos nesse computador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote screen viewing is not available on Windows yet. Bots can still use apps on that computer."
          }
        }
      }
    },
    "No computador, abra Mexerica → Ajustes → Acesso ao computador. As permissões são configuradas separadamente em cada computador.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No computador, abra Mexerica → Ajustes → Acesso ao computador. As permissões são configuradas separadamente em cada computador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the computer, open Mexerica → Settings → Computer access. Permissions are set separately on each computer."
          }
        }
      }
    },
    "A tela remota está desativada. %@": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
