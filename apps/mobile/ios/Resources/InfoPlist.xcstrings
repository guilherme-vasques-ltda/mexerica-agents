{
  "sourceLanguage": "pt-BR",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o código de pareamento mostrado no computador."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the pairing code shown on your computer."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converse com seus bots em uma chamada de voz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to your bots in a voice call."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua fala é transcrita neste iPhone e enviada ao bot como mensagem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words are transcribed on this iPhone and sent to your bot as a message."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Mexerica se conecta ao computador que executa seus bots na rede local."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mexerica connects to the computer running your bots on your local network."
          }
        }
      }
    }
  },
  "version": "1.0"
