    },
    "Toque e segure a Tela Bloqueada → Personalizar → Tela Bloqueada. Toque na área de widgets e escolha Mexerica. Widgets em linha ficam na data acima do relógio.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure a Tela Bloqueada → Personalizar → Tela Bloqueada. Toque na área de widgets e escolha Mexerica. Widgets em linha ficam na data acima do relógio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Lock Screen → Customize → Lock Screen. Tap the widget area and choose Mexerica. Inline widgets go in the date row above the clock."
          }
        }
      }
    },
    "Escolha Bots para ver o estado das tarefas ou Limites de uso para ver o maior limite informado. O iOS aplica a cor e o estilo da Tela Bloqueada.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Bots para ver o estado das tarefas ou Limites de uso para ver o maior limite informado. O iOS aplica a cor e o estilo da Tela Bloqueada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Bots for task status or Usage limits for the highest reported limit. iOS applies your Lock Screen's color and style."
          }
        }
      }
    },
