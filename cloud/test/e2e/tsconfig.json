{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "paths": {
      "@noble/ciphers/chacha.js": [
        "../../node_modules/@noble/ciphers/chacha.d.ts"
      ],
      "@noble/curves/ed25519.js": [
        "../../node_modules/@noble/curves/ed25519.d.ts"
      ],
      "@noble/curves/utils.js": [
        "../../node_modules/@noble/curves/utils.d.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "../ref.ts",
    "../../vitest.config.ts"
  ]
}
