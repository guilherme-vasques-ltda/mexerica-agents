{
	"name": "@earendil-works/pi-schema",
	"version": "1.5.2",
	"description": "JSON Schema validation without eval: drafts 2020-12 and 7, compiled into plain closures",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./src/index.ts",
		"./formats": "./src/formats/index.ts",
		"./*": "./src/*"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"bench": "node --expose-gc test/bench/all.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"json-schema",
		"validation",
		"validator",
		"csp"
	],
	"author": "Earendil Works",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/schema"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}