[Unit]
Description=Backup cifrado do Hub Donnabot
StartLimitIntervalSec=1d
StartLimitBurst=3

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 %h/.local/lib/donnabot-backup/backup.py backup --config %h/.config/donnabot-backup/config.json
Restart=on-failure
RestartSec=15min
TimeoutStartSec=45min
TimeoutStopSec=30s
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
TasksMax=16
StandardOutput=journal
StandardError=journal
